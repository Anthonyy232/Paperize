  <string name="privacy_intro_title">Introduktion</string>
  <string name="privacy_intro_content">Velkommen til %1$s! Denne privatlivsmeddelelse beskriver, hvordan vi indsamler, bruger og beskytter dine personlige oplysninger, når du bruger vores mobilapp. Ved at bruge %1$s accepterer du vilkårene i denne meddelelse.</string>
  <string name="privacy_data_collection_title">Dataindsamling</string>
  <string name="privacy_data_collection_content">Notifikationer: %1$s anmoder om tilladelse til at vise sine egne notifikationer om baggrundsskift, handlinger i baggrunden og fejl. Appen læser ikke notifikationer fra andre apps og bruger dem ikke til at anbefale baggrunde.\n\nLokale filer: %1$s får adgang til de billeder og mapper, du vælger, så de kan indstilles som baggrund. Vi uploader eller overfører ikke disse filer til eksterne servere.</string>
  <string name="privacy_information_usage_title">Brug af oplysninger</string>
  <string name="privacy_information_usage_content">Personlige data: Vi indsamler eller gemmer ingen personlige data som navne, e-mailadresser eller telefonnumre.\n\nBrugsanalyse: %1$s sporer ikke din brugsadfærd og indsamler ingen analysedata.</string>
  <string name="privacy_data_security_title">Datasikkerhed</string>
  <string name="privacy_data_security_content">Lagring på enheden: Alle data, som %1$s bruger, forbliver på din enhed. Vi sender eller gemmer ingen data eksternt.</string>
