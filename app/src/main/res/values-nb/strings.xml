  <string name="privacy_intro_title">Introduksjon</string>
  <string name="privacy_intro_content">Velkommen til %1$s! Denne personvernmerknaden beskriver hvordan vi samler inn, bruker og beskytter personopplysningene dine når du bruker mobilappen vår. Ved å bruke %1$s godtar du vilkårene i denne merknaden.</string>
  <string name="privacy_data_collection_title">Datainnsamling</string>
  <string name="privacy_data_collection_content">Varsler: %1$s ber om tillatelse til å vise egne varsler om bytte av bakgrunnsbilde, bakgrunnsoperasjoner og feil. Appen leser ikke varsler fra andre apper og bruker dem ikke til å anbefale bakgrunnsbilder.\n\nLokale filer: %1$s får tilgang til bildene og mappene du velger, slik at de kan angis som bakgrunnsbilder. Vi laster ikke opp eller overfører disse filene til eksterne servere.</string>
  <string name="privacy_information_usage_title">Bruk av informasjon</string>
  <string name="privacy_information_usage_content">Personopplysninger: Vi samler ikke inn eller lagrer personopplysninger som navn, e-postadresser eller telefonnumre.\n\nBruksanalyse: %1$s sporer ikke bruksmønsteret ditt og samler ikke inn analysedata.</string>
  <string name="privacy_data_security_title">Datasikkerhet</string>
  <string name="privacy_data_security_content">Lagring på enheten: Alle data som brukes av %1$s, blir værende på enheten din. Vi overfører eller lagrer ingen data eksternt.</string>
